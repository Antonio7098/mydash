{
  "schemaVersion": 1,
  "kind": "layout",
  "id": "dashboard-shell",
  "name": "Dashboard Shell",
  "description": "Responsive page shell with a compact header, bounded content region and composable grid utilities.",
  "level": "core",
  "slot": "page-layout",
  "contractVersion": 1,
  "entry": "layout.css",
  "props": {
    "density": {
      "type": "comfortable|compact",
      "required": false,
      "description": "Controls the default spacing rhythm."
    }
  },
  "variants": {
    "density": [
      "comfortable",
      "compact"
    ]
  },
  "supportedThemes": [
    "hsbc-light"
  ],
  "dependencies": {
    "primitives": {
      "button": "core/button",
      "status": "core/status-badge"
    },
    "components": {
      "metric-summary": "core/metric-card",
      "section-heading": "core/section-heading"
    },
    "assets": {
      "brand-logo": "core/mydash-brand-mark"
    }
  }
}
