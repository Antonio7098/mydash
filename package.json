{
  "name": "mydash",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first library, preview and export system for standalone HTML dashboards, presentations and concepts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preflight": "node scripts/00-preflight.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/00-preflight.mjs --check-remote",
    "test": "npm run build && node --test build-test/tests/unit/*.test.js build-test/tests/integration/*.test.js",
    "validate": "node scripts/tasks/validate.mjs",
    "start": "npm run build && node dist/server/start.js",
    "export": "node scripts/tasks/export.mjs",
    "validate:contracts": "node scripts/tasks/validate-contracts.mjs",
    "mydash": "node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "build:test": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist build-test",
    "test:cli": "node scripts/tasks/test-cli.mjs",
    "test:files": "node scripts/tasks/test-files.mjs",
    "test:office": "node scripts/tasks/test-office.mjs",
    "fixtures:office": "node scripts/tasks/create-office-fixtures.mjs",
    "test:data": "node scripts/tasks/test-data.mjs",
    "test:library": "node scripts/tasks/test-library.mjs",
    "test:resolution": "node scripts/tasks/test-resolution.mjs",
    "test:export": "node scripts/tasks/test-export.mjs",
    "test:validation": "node scripts/tasks/test-validation.mjs",
    "test:git": "node scripts/tasks/test-git.mjs",
    "test:server": "node scripts/tasks/test-server.mjs",
    "test:skills": "node scripts/tasks/test-skills.mjs",
    "test:core": "node scripts/tasks/test-core.mjs",
    "test:navigator": "node scripts/tasks/test-navigator.mjs",
    "test:gallery": "node scripts/tasks/test-gallery.mjs",
    "test:viewer": "node scripts/tasks/test-viewer.mjs",
    "test:appearance-controls": "node scripts/tasks/test-appearance-controls.mjs",
    "test:library-browser": "node scripts/tasks/test-library-browser.mjs",
    "check:source": "node scripts/tasks/check-source.mjs",
    "smoke": "node scripts/tasks/smoke.mjs",
    "test:polish": "node scripts/tasks/test-polish.mjs"
  },
  "bin": {
    "mydash": "dist/cli/index.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "esbuild": "0.28.1",
    "parse5": "8.0.1",
    "express": "5.2.1"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5",
    "@types/express": "5.0.0"
  }
}
