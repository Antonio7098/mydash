{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-dashboards.local/schemas/provenance.schema.json",
  "title": "Generated data provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "sourceHash",
    "generatedAt",
    "command",
    "toolVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    }
  }
}
