{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-dashboards.local/schemas/data-recipe.schema.json",
  "title": "Repeatable data extraction recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "source",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "file"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "excel",
            "csv",
            "json",
            "powerpoint"
          ]
        },
        "file": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "format"
      ],
      "properties": {
        "file": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "json",
            "ndjson"
          ]
        },
        "overwrite": {
          "type": "boolean"
        }
      }
    }
  }
}
